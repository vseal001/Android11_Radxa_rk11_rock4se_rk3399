    // Predicate_X86pcmpm_commute
    SDNode *N = Node;

  ISD::CondCode CC = cast<CondCodeSDNode>(N->getOperand(2))->get();
  return !ISD::isUnsignedIntSetCC(CC);

  }
  case 47: { 
    // Predicate_X86pcmpum
    // Predicate_X86pcmpum_commute
    SDNode *N = Node;

  ISD::CondCode CC = cast<CondCodeSDNode>(N->getOperand(2))->get();
  return ISD::isUnsignedIntSetCC(CC);

  }
  case 48: { 
    // Predicate_memop
    SDNode *N = Node;

  auto *Ld = cast<LoadSDNode>(N);
  return Subtarget->hasSSEUnalignedMem() ||
         Ld->getAlignment() >= Ld->getMemoryVT().getStoreSize();

  }
  case 49: { 
    // Predicate_immAllOnesV
    SDNode *N = Node;

  return ISD::isBuildVectorAllOnes(N);

  }
  case 50: { 
    // Predicate_PrefetchWLevel
    auto *N = cast<ConstantSDNode>(Node);

  return N->getSExtValue() == 3 || !Subtarget->hasPREFETCHWT1();

  }
  case 51: { 
    // Predicate_PrefetchWT1Level
    int64_t Imm = cast<ConstantSDNode>(Node)->getSExtValue();

  return Imm < 3;

  }
  case 52: { 
    // Predicate_X86tcret_6regs
    SDNode *N = Node;

  // X86tcret args: (*chain, ptr, imm, regs..., glue)
  unsigned NumRegs = 0;
  for (unsigned i = 3, e = N->getNumOperands(); i != e; ++i)
    if (isa<RegisterSDNode>(N->getOperand(i)) && ++NumRegs > 6)
      return false;
  return true;

  }
  case 53: { 
    // Predicate_zextload
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getExtensionType() != ISD::ZEXTLOAD) return false;
return true;

  }
  case 54: { 
    // Predicate_zextloadi32
    // Predicate_sextloadi32
    // Predicate_extloadi32
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getMemoryVT() != MVT::i32) return false;
return true;

  }
  case 55: { 
    // Predicate_i64relocImmSExt8
    SDNode *N = Node;

  return isSExtRelocImm<8>(N);

  }
  case 56: { 
    // Predicate_i64relocImmSExt32
    SDNode *N = Node;

  return isSExtRelocImm<32>(N);

  }
  case 57: { 
    // Predicate_sub_is_xor
    SDNode *N = Node;

  if (ConstantSDNode *CN = dyn_cast<ConstantSDNode>(N->getOperand(0))) {
    KnownBits Known;
    CurDAG->computeKnownBits(N->getOperand(1), Known);

    // If all possible ones in the RHS are set in the LHS then there can't be
    // a borrow and we can use xor.
    return (~Known.Zero).isSubsetOf(CN->getAPIntValue());
  }

  return false;

  }
  case 58: { 
    // Predicate_or_is_add
    SDNode *N = Node;

  if (ConstantSDNode *CN = dyn_cast<ConstantSDNode>(N->getOperand(1)))
    return CurDAG->MaskedValueIsZero(N->getOperand(0), CN->getAPIntValue());

  KnownBits Known0;
  CurDAG->computeKnownBits(N->getOperand(0), Known0, 0);
  KnownBits Known1;
  CurDAG->computeKnownBits(N->getOperand(1), Known1, 0);
  return (~Known0.Zero & ~Known1.Zero) == 0;

  }
  case 59: { 
    // Predicate_BTCBTSMask64
    int64_t Imm = cast<ConstantSDNode>(Node)->getSExtValue();

  return !isInt<32>(Imm) && isPowerOf2_64(Imm);

  }
  case 60: { 
    // Predicate_sextload
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getExtensionType() != ISD::SEXTLOAD) return false;
return true;

  }
  case 61: { 
    // Predicate_sextloadi8
    // Predicate_zextloadi8
    // Predicate_extloadi8
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getMemoryVT() != MVT::i8) return false;
return true;

  }
  case 62: { 
    // Predicate_sextloadi16
    // Predicate_zextloadi16
    // Predicate_extloadi16
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getMemoryVT() != MVT::i16) return false;
return true;

  }
  case 63: { 
    // Predicate_zextloadi1
    // Predicate_extloadi1
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getMemoryVT() != MVT::i1) return false;
return true;

  }
  case 64: { 
    // Predicate_extload
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getExtensionType() != ISD::EXTLOAD) return false;
return true;

  }
  case 65: { 
    // Predicate_extloadf32
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getMemoryVT() != MVT::f32) return false;
return true;

  }
  case 66: { 
    // Predicate_extloadf64
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getMemoryVT() != MVT::f64) return false;
return true;

  }
  case 67: { 
    // Predicate_alignedloadf128
    // Predicate_alignednontemporalload
    SDNode *N = Node;

  LoadSDNode *Ld = cast<LoadSDNode>(N);
  return Ld->getAlignment() >= Ld->getMemoryVT().getStoreSize();

  }
  case 68: { 
    // Predicate_nontemporalload
    SDNode *N = Node;

  return cast<LoadSDNode>(N)->isNonTemporal();

  }
  case 69: { 
    // Predicate_alignedvecload
    SDNode *N = Node;

  auto *Ld = cast<LoadSDNode>(N);
  return Ld->getAlignment() >= Ld->getMemoryVT().getStoreSize() &&
         !useNonTemporalLoad(cast<LoadSDNode>(N));

  }
  case 70: { 
    // Predicate_sextloadvi8
    // Predicate_zextloadvi8
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getMemoryVT().getScalarType() != MVT::i8) return false;
return true;

  }
  case 71: { 
    // Predicate_sextloadvi16
    // Predicate_zextloadvi16
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getMemoryVT().getScalarType() != MVT::i16) return false;
return true;

  }
  case 72: { 
    // Predicate_sextloadvi32
    // Predicate_zextloadvi32
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getMemoryVT().getScalarType() != MVT::i32) return false;
return true;

  }
  case 73: { 
    // Predicate_extloadvf32
    SDNode *N = Node;
if (cast<LoadSDNode>(N)->getMemoryVT().getScalarType() != MVT::f32) return false;
return true;

  }
  case 74: { 
    // Predicate_truncstore_s_vi8
    SDNode *N = Node;

  return cast<TruncSStoreSDNode>(N)->getMemoryVT().getScalarType() == MVT::i8;

  }
  case 75: { 
    // Predicate_truncstore_s_vi16
    SDNode *N = Node;

  return cast<TruncSStoreSDNode>(N)->getMemoryVT().getScalarType() == MVT::i16;

  }
  case 76: { 
    // Predicate_truncstore_s_vi32
    SDNode *N = Node;

  return cast<TruncSStoreSDNode>(N)->getMemoryVT().getScalarType() == MVT::i32;

  }
  case 77: { 
    // Predicate_masked_truncstore_s_vi8
    SDNode *N = Node;

  return cast<MaskedTruncSStoreSDNode>(N)->getMemoryVT().getScalarType() == MVT::i8;

  }
  case 78: { 
    // Predicate_masked_truncstore_s_vi16
    SDNode *N = Node;

