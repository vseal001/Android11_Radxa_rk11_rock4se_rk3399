  }
  case 82: { 
    // Predicate_truncstore_us_vi32
    SDNode *N = Node;

  return cast<TruncUSStoreSDNode>(N)->getMemoryVT().getScalarType() == MVT::i32;

  }
  case 83: { 
    // Predicate_masked_truncstore_us_vi8
    SDNode *N = Node;

  return cast<MaskedTruncUSStoreSDNode>(N)->getMemoryVT().getScalarType() == MVT::i8;

  }
  case 84: { 
    // Predicate_masked_truncstore_us_vi16
    SDNode *N = Node;

  return cast<MaskedTruncUSStoreSDNode>(N)->getMemoryVT().getScalarType() == MVT::i16;

  }
  case 85: { 
    // Predicate_masked_truncstore_us_vi32
    SDNode *N = Node;

  return cast<MaskedTruncUSStoreSDNode>(N)->getMemoryVT().getScalarType() == MVT::i32;

  }
  case 86: { 
    // Predicate_X86lock_inc_8
    // Predicate_X86lock_dec_8
    SDNode *N = Node;

    return cast<MemIntrinsicSDNode>(N)->getMemoryVT() == MVT::i8;
  
  }
  case 87: { 
    // Predicate_X86lock_inc_16
    // Predicate_X86lock_dec_16
    SDNode *N = Node;

    return cast<MemIntrinsicSDNode>(N)->getMemoryVT() == MVT::i16;
  
  }
  case 88: { 
    // Predicate_X86lock_inc_32
    // Predicate_X86lock_dec_32
    SDNode *N = Node;

    return cast<MemIntrinsicSDNode>(N)->getMemoryVT() == MVT::i32;
  
  }
  case 89: { 
    // Predicate_X86lock_inc_64
    // Predicate_X86lock_dec_64
    SDNode *N = Node;

    return cast<MemIntrinsicSDNode>(N)->getMemoryVT() == MVT::i64;
  
  }
  case 90: { 
    // Predicate_def32
    SDNode *N = Node;

  return N->getOpcode() != ISD::TRUNCATE &&
         N->getOpcode() != TargetOpcode::EXTRACT_SUBREG &&
         N->getOpcode() != ISD::CopyFromReg &&
         N->getOpcode() != ISD::AssertSext &&
         N->getOpcode() != ISD::AssertZext;

  }
  case 91: { 
    // Predicate_memopf128
    SDNode *N = Node;

  LoadSDNode *Ld = cast<LoadSDNode>(N);
  return Subtarget->hasSSEUnalignedMem() ||
         Ld->getAlignment() >= Ld->getMemoryVT().getStoreSize();

  }
  case 92: { 
    // Predicate_fp32imm0
    // Predicate_fp64imm0
    auto *N = cast<ConstantFPSDNode>(Node);

  return N->isExactlyValue(+0.0);

  }
  case 93: { 
    // Predicate_fpimm0
    const APFloat & Imm = cast<ConstantFPSDNode>(Node)->getValueAPF();

  return Imm.isExactlyValue(+0.0);

  }
  case 94: { 
    // Predicate_fpimm1
    const APFloat & Imm = cast<ConstantFPSDNode>(Node)->getValueAPF();

  return Imm.isExactlyValue(+1.0);

  }
  case 95: { 
    // Predicate_fpimmneg0
    const APFloat & Imm = cast<ConstantFPSDNode>(Node)->getValueAPF();

  return Imm.isExactlyValue(-0.0);

  }
  case 96: { 
    // Predicate_fpimmneg1
    const APFloat & Imm = cast<ConstantFPSDNode>(Node)->getValueAPF();

  return Imm.isExactlyValue(-1.0);

  }
  case 97: { 
    // Predicate_maskzeroupperv1i1
    // Predicate_maskzeroupperv8i1
    // Predicate_maskzeroupperv16i1
    // Predicate_maskzeroupperv32i1
    // Predicate_maskzeroupperv2i1
    // Predicate_maskzeroupperv4i1
    SDNode *N = Node;

    return isMaskZeroExtended(N);
  
  }
  case 98: { 
    // Predicate_X86mload
    // Predicate_masked_load_unaligned
    SDNode *N = Node;

  return !cast<MaskedLoadSDNode>(N)->isExpandingLoad() &&
    cast<MaskedLoadSDNode>(N)->getExtensionType() == ISD::NON_EXTLOAD;

  }
  case 99: { 
    // Predicate_masked_load_aligned512
    SDNode *N = Node;

  return cast<MaskedLoadSDNode>(N)->getAlignment() >= 64;

  }
  case 100: { 
    // Predicate_X86mExpandingLoad
    SDNode *N = Node;

  return cast<MaskedLoadSDNode>(N)->isExpandingLoad();

  }
  case 101: { 
    // Predicate_masked_load_aligned256
    SDNode *N = Node;

  return cast<MaskedLoadSDNode>(N)->getAlignment() >= 32;

  }
  case 102: { 
    // Predicate_masked_load_aligned128
    SDNode *N = Node;

  return cast<MaskedLoadSDNode>(N)->getAlignment() >= 16;

  }
  case 103: { 
    // Predicate_UnpckhUnary
    SDNode *N = Node;

  return N->getOperand(0) == N->getOperand(1);

  }
  case 104: { 
    // Predicate_mgatherv4i32
    SDNode *N = Node;

  X86MaskedGatherSDNode *Mgt = cast<X86MaskedGatherSDNode>(N);
  return Mgt->getIndex().getValueType() == MVT::v4i32;

  }
  case 105: { 
    // Predicate_mgatherv2i64
    SDNode *N = Node;

  X86MaskedGatherSDNode *Mgt = cast<X86MaskedGatherSDNode>(N);
  return Mgt->getIndex().getValueType() == MVT::v2i64;

  }
  case 106: { 
    // Predicate_mgatherv4i64
    SDNode *N = Node;

  X86MaskedGatherSDNode *Mgt = cast<X86MaskedGatherSDNode>(N);
  return Mgt->getIndex().getValueType() == MVT::v4i64;

  }
  case 107: { 
    // Predicate_mgatherv8i32
    SDNode *N = Node;

  X86MaskedGatherSDNode *Mgt = cast<X86MaskedGatherSDNode>(N);
  return Mgt->getIndex().getValueType() == MVT::v8i32;

  }
  case 108: { 
    // Predicate_mgatherv8i64
    SDNode *N = Node;

  X86MaskedGatherSDNode *Mgt = cast<X86MaskedGatherSDNode>(N);
  return Mgt->getIndex().getValueType() == MVT::v8i64;

  }
  case 109: { 
    // Predicate_mgatherv16i32
    SDNode *N = Node;

  X86MaskedGatherSDNode *Mgt = cast<X86MaskedGatherSDNode>(N);
  return Mgt->getIndex().getValueType() == MVT::v16i32;

  }
  case 110: { 
    // Predicate_mscatterv8i32
    SDNode *N = Node;

  X86MaskedScatterSDNode *Sc = cast<X86MaskedScatterSDNode>(N);
  return Sc->getIndex().getValueType() == MVT::v8i32;

  }
  case 111: { 
    // Predicate_mscatterv8i64
    SDNode *N = Node;

  X86MaskedScatterSDNode *Sc = cast<X86MaskedScatterSDNode>(N);
  return Sc->getIndex().getValueType() == MVT::v8i64;

  }
  case 112: { 
    // Predicate_mscatterv4i32
    SDNode *N = Node;

  X86MaskedScatterSDNode *Sc = cast<X86MaskedScatterSDNode>(N);
  return Sc->getIndex().getValueType() == MVT::v4i32;

  }
  case 113: { 
    // Predicate_mscatterv4i64
    SDNode *N = Node;

  X86MaskedScatterSDNode *Sc = cast<X86MaskedScatterSDNode>(N);
  return Sc->getIndex().getValueType() == MVT::v4i64;

  }
  case 114: { 
    // Predicate_mscatterv2i64
    SDNode *N = Node;

  X86MaskedScatterSDNode *Sc = cast<X86MaskedScatterSDNode>(N);
  return Sc->getIndex().getValueType() == MVT::v2i64;

  }
  case 115: { 
    // Predicate_mscatterv16i32
    SDNode *N = Node;

  X86MaskedScatterSDNode *Sc = cast<X86MaskedScatterSDNode>(N);
  return Sc->getIndex().getValueType() == MVT::v16i32;

  }
  }
